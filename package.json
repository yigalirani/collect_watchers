{
    "name": "collect_watchers",
    "version": "1.0.0",
    "description": "",
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "dist/index.js",
    "types": "types/src/index.d.ts",
    "watchers":{
      "$watch":[
        "src",
        "package.json",
        "tsconfig.json",
        "bin/run_build.ts"
      ],
      "test":"dist/test.js",
      "eslint":{
        "watch":["$watch","eslint.config.mjs"],
        "filter":"eslint_filter"
      }
    },        
    "scripts": {
        "test": "node dist/test.js",
        "build":"node ./bin/run_build.ts",
        "eslint": "npx eslint . --debug --color",
        "tsc":"npx tsc"
    },
    "keywords": [],
    "devDependencies": {
        "@eslint/js": "9.39.1",
        "@types/node": "24.10.0",
        "esbuild": "0.25.12",
        "eslint-plugin-import-x": "4.16.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.46.3"
    },
    "dependencies": {
        "@yigal/base_types": "1.4.0",
        "@yigal/watch_runner": "^2.0.0"
    }
}
